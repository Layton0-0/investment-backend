# ============================================
# Investment Backend - 환경 변수 설정
# ============================================
# 이 파일을 .env로 복사하여 사용하세요.
# 절대 .env 파일을 Git에 커밋하지 마세요.

# ============================================
# 한국투자증권 KIS API 설정
# ============================================
# [주의] API 키와 서버 타입은 계정별로 DB에서 관리됨
# - 일반 사용자: 회원가입 시 본인이 직접 입력 → DB에 저장
# - SUPER_ADMIN: 아래 SUPER_ADMIN_*로 설정 → 앱 시작 시 DB 동기화
# - 서버 타입: 화면 토글 시 해당 계좌의 serverType 자동 인식

# 토큰 캐시 사용 여부 (전역 설정)
KOREA_INVESTMENT_USE_TOKEN_CACHE=true

# ============================================
# SUPER ADMIN 계정 설정 (필수)
# ============================================
# 시스템 관리자 계정 - 앱 시작 시 자동으로 DB에 생성/동기화됨
# KIS Developers (https://apiportal.koreainvestment.com)에서 발급

# 로그인 정보
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# 모의투자 계좌 (serverType=1)
SUPER_ADMIN_VIRTUAL_APP_KEY=
SUPER_ADMIN_VIRTUAL_APP_SECRET=
SUPER_ADMIN_VIRTUAL_ACCOUNT_NO=

# 실전투자 계좌 (serverType=0)
SUPER_ADMIN_REAL_APP_KEY=
SUPER_ADMIN_REAL_APP_SECRET=
SUPER_ADMIN_REAL_ACCOUNT_NO=

# ============================================
# DART Open API (금융감독원 공시)
# ============================================
# https://opendart.fss.or.kr 에서 발급
DART_API_KEY=your_dart_api_key_here

# ============================================
# SEC EDGAR
# ============================================
# API Key 불필요, User-Agent에 이메일 포함 필수
SEC_USER_AGENT=InvestmentApp admin@example.com

# ============================================
# 시장 데이터 설정
# ============================================
# 제공자: korea-investment
MARKET_DATA_PROVIDER=korea-investment

# Mock 데이터 사용 (개발/테스트용)
MARKET_DATA_USE_MOCK_DATA=false

# ============================================
# 데이터베이스
# ============================================
DATABASE_URL=jdbc:postgresql://localhost:5432/investment
DATABASE_USERNAME=investment
DATABASE_PASSWORD=your_db_password_here

# JPA 설정
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ============================================
# 서버 설정
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ============================================
# 로깅
# ============================================
LOG_LEVEL=INFO
LOG_PATH=/LOG

# ============================================
# Data Collector URL (Python FastAPI)
# ============================================
DATA_COLLECTOR_URL=http://localhost:8000
